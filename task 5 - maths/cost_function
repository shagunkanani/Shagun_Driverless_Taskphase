import numpy as np
from scipy.optimize import minimize

car_x = 0.1
car_y = 3.1

steps = 3
dt = 0.02
theta = np.pi/2

current_vel = 5.5
desired_vel = 10

initial_acc = 1.3
initial_yaw_rate = 0.23

waypoints = [(1.0, 1.0), (0.9, 2.0), (0.9, 3.0), (1.0, 4.1), (1.7, 5.0), (2.3, 6.0)]

def prediction(a, omega):
    x = car_x
    y = car_y
    v = current_vel
    heading = theta

    predicted = []

    for i in range(steps):
        x = x + v * np.cos(heading) * dt
        y = y + v * np.sin(heading) * dt
        v = v + a * dt
        heading = heading + omega * dt
        predicted.append((x, y, v, heading))

    return predicted

weights = {
    "heading": 10.0,
    "cross_track": 1.0,
    "velocity": 0.1
}

scales = {
    "heading": 1.0,
    "cross_track": 1.0,
    "velocity": 1.0
}

print(weights)

x1, y1 = waypoints[1]
x2, y2 = waypoints[3]

dx = x2 - x1
dy = y2 - y1

desired_heading = np.arctan2(dy, dx)

def heading_error(heading):
    error = np.arctan2(
        np.sin(desired_heading - heading),
        np.cos(desired_heading - heading)
    )
    return error

def cross_track_error(x, y):
    error = (dx * (y - y1) - dy * (x - x1)) / np.sqrt(dx**2 + dy**2)
    return error

def cost(control):
    a, omega = control
    predicted = prediction(a, omega)

    heading_cost = 0.0
    cross_track_cost = 0.0
    velocity_cost = 0.0

    for x, y, v, heading in predicted:
        h_error = heading_error(heading)
        heading_cost += (h_error / scales["heading"])**2

        c_error = cross_track_error(x, y)
        cross_track_cost += (c_error / scales["cross_track"])**2

        v_error = desired_vel - v
        velocity_cost += (v_error / scales["velocity"])**2

    total_cost = (
        weights["heading"] * heading_cost +
        weights["cross_track"] * cross_track_cost +
        weights["velocity"] * velocity_cost
    )

    return total_cost

def cost_breakdown(control):
    a, omega = control
    predicted = prediction(a, omega)

    heading_cost = 0
    cross_track_cost = 0
    velocity_cost = 0

    for x, y, v, heading in predicted:
        heading_cost += (heading_error(heading) / scales["heading"])**2
        cross_track_cost += (cross_track_error(x, y) / scales["cross_track"])**2
        velocity_cost += ((desired_vel - v) / scales["velocity"])**2

    print("Heading cost:", heading_cost)
    print("Cross-track cost:", cross_track_cost)
    print("Velocity cost:", velocity_cost)
    print("Total cost:", cost(control))


initial_guess = (initial_acc, initial_yaw_rate)
initial_cost = cost(initial_guess)

bounds = [(-10, 10), (-1.5, 1.5)]

result = minimize(cost, initial_guess, method="L-BFGS-B", bounds=bounds)

optimal_acc, optimal_yaw_rate = result.x
optimal_cost = result.fun

print("Success:", result.success)
print("Message:", result.message)

print("Optimal acceleration:", optimal_acc)
print("Optimal yaw rate:", optimal_yaw_rate)
print("Initial cost:", initial_cost)
print("Optimised cost:", result.fun)

print("\nInitial cost breakdown:")
cost_breakdown(initial_guess)

print("\nOptimised cost breakdown:")
cost_breakdown(result.x)