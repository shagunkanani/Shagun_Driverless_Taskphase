"""Q2. Create a class with a function that does selection sort on a list of strings. 
Input a list like Q1, call the function, print the output. """

class sorting:
    @staticmethod
    def selection_sort(sort):
        for i in range(0,len(sort)):
                m=i
                for j in range(i+1,len(sort)):
                    if sort[j]<sort[m]:
                        m=j
                temp = sort[m]
                sort[m] = sort[i]
                sort[i] = temp
        return sort

n = int(input("Enter a number:"))
list = []
for i in range(1, (n + 1)):
    list.append(input("Enter string " + str(i) + ": "))
print("List before sorting: ", list)
sorted_list = sorting.selection_sort(list)
print("List after sorting: ", sorted_list)

    
