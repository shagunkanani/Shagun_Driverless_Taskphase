"""Q7. Let (x,y) be a point in 2D space. 
Given a list of coordinates, write a sort function that sorts them by proximity to a reference point given by the user that is not in the list. 
Eg list [(0,1),(0,3),(1,2)] , reference (0,0) , output [(0,1),(1,2),(0,3)] """

n=input("Enter the number of points: ")
points=[]
for i in range(int(n)):
    points.append(tuple(map(int, input("Enter coordinates in the form (x,y): ").split(','))))
ref= tuple(map(int, input("Enter a reference point in the form (x,y): ").split(',')))
dist ={}

for i in range(len(points)):
    d= ((points[i][0]-ref[0])**2 + (points[i][1]-ref[1])**2)**0.5
    dist[points[i]] = d

for i in range(0,len(points)):
        m=i
        for j in range(i+1,len(points)):
            if dist[points[j]] < dist[points[m]]:
                m=j
        temp = points[m]
        points[m] = points[i]
        points[i] = temp

print("Points sorted by proximity to the reference point: ", points)

